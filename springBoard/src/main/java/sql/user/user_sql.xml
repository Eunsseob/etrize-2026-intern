<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="user">
    
    <resultMap type="com.spring.user.vo.UserVo" id="userVo">
    	<result property="userId" 	column="USER_ID"/>
    	<result property="userPw" 	column="USER_PW"/>
    	<result property="userName" 	column="USER_NAME"/>
    	<result property="userPhone" column="USER_PHONE"/>
    </resultMap>
    
    <select id="userLogin" parameterType="com.spring.user.vo.UserVo" resultMap="userVo">
		  SELECT
	  	  	   USER_NAME
	  	  FROM
	     	   USER_INFO
	 	   WHERE
	  	       USER_ID = #{userId, jdbcType=VARCHAR}
	 		   AND USER_PW  = #{userPw, jdbcType=VARCHAR}
    </select>
    
    <select id="userIdcheck" parameterType="com.spring.user.vo.UserVo" resultType="Integer">
		  SELECT
	  	  	   count(*)
	  	  FROM
	     	   USER_INFO
	 	   WHERE
	  	       USER_ID = #{userId, jdbcType=VARCHAR}
    </select>
    
    <insert id="userSignup" parameterType="com.spring.user.vo.UserVo">
	    INSERT INTO USER_INFO
	    (
	        USER_ID,
	        USER_PW,
	        USER_NAME,
	        USER_PHONE,
	        BIRTH,
	        IS_OWNER,
	        BUSINESS_NUM
	    )
	    VALUES
	    (
	        #{userId},
	        #{userPw},
	        #{userName},
	        #{userPhone},
	        #{birth},
	        #{isOwner},
	        #{businessNum}
	    )
	</insert>
</mapper>
