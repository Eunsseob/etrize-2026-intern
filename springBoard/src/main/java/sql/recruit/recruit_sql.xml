<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="recruit">
    
    <resultMap type="com.spring.recruit.vo.RecruitVo" id="recruitVo">
	    <result property="seq"      column="SEQ"/>
	    <result property="name"     column="NAME"/>
	    <result property="birth"    column="BIRTH"/>
	    <result property="gender"   column="GENDER"/>
	    <result property="phone"    column="PHONE"/>
	    <result property="email"    column="EMAIL"/>
	    <result property="addr"     column="ADDR"/>
	    <result property="location" column="LOCATION"/>
	    <result property="workType" column="WORK_TYPE"/>
	    <result property="submit"   column="SUBMIT"/>
	</resultMap>
    

      
      <!-- 유저를 로그인 시키기 위한 쿼리문 -->
      <insert id="userSignup1" parameterType="com.spring.recruit.vo.RecruitVo">
	    INSERT INTO RECRUIT (NAME, PHONE)
	    VALUES (#{name, jdbcType=VARCHAR}, #{phone, jdbcType=VARCHAR})
	</insert>
	      
      <!-- 이력서를 업데이트 시키기 위한 쿼리문 -->
      <update id="updateRecruit" parameterType="com.spring.recruit.vo.RecruitVo">
		    UPDATE RECRUIT
		    <set>
		        <if test="name != null">NAME = #{name},</if>
		        <if test="birth != null">BIRTH = #{birth},</if>
		        <if test="gender != null">GENDER = #{gender},</if>
		        <if test="phone != null">PHONE = #{phone},</if>
		        <if test="email != null">EMAIL = #{email},</if>
		        <if test="addr != null">ADDR = #{addr},</if>
		        <if test="location != null">LOCATION = #{location},</if>
		        <if test="workType != null">WORK_TYPE = #{workType},</if>
		        SUBMIT = 'S'
		    </set>
		    WHERE SEQ = #{seq}
		</update>

		<!-- 저장한 이력서 중 RECRUIT를 가져오는 쿼리문 -->
		<select id="getRecruit" parameterType="String" resultMap="recruitVo">
		    SELECT * FROM RECRUIT WHERE SEQ = #{seq, jdbcType=VARCHAR}
		</select>
		
		<!-- 제출버튼을 위한 쿼리문 -->
		<update id="submitRecruit" parameterType="String">
		    UPDATE RECRUIT SET SUBMIT = 'Y' WHERE SEQ = #{seq, jdbcType=VARCHAR}
		</update>
		
		<select id="numberCheck" parameterType="String" resultType="int">
      		SELECT COUNT(*)
      		FROM RECRUIT
      		WHERE PHONE = #{phone, jdbcType=VARCHAR}
      	</select>
      	
      	<insert id="mergeUser" parameterType="com.spring.recruit.vo.RecruitVo">
		    INSERT INTO RECRUIT (NAME, PHONE)
		    VALUES (#{name, jdbcType=VARCHAR}, #{phone, jdbcType=VARCHAR})
		    ON CONFLICT (PHONE) DO NOTHING
		</insert>
</mapper>
