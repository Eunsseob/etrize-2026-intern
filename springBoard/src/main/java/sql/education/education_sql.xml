<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="education">
    
    <resultMap type="com.spring.education.vo.EducationVo" id="educationVo">
	    <result property="eduSeq" column="EDU_SEQ"/>
	    <result property="seq" column="SEQ"/>
	    <result property="schoolName" column="SCHOOL_NAME"/>
	    <result property="division" column="DIVISION"/>
	    <result property="startPeriod" column="START_PERIOD"/>
	    <result property="endPeriod" column="END_PERIOD"/>
	    <result property="major" column="MAJOR"/>
	    <result property="grade" column="GRADE"/>
	    <result property="location" column="LOCATION"/>
	</resultMap>
	
	<!-- 학력을 넣기위한 쿼리문 -->
     <insert id="insertEducation" parameterType="com.spring.education.vo.EducationVo">
	    INSERT INTO EDUCATION (EDU_SEQ, SEQ, SCHOOL_NAME, DIVISION, START_PERIOD, END_PERIOD, MAJOR, GRADE, LOCATION)
	    VALUES (
	        EDU_SEQ.NEXTVAL,
	        #{seq},
	        #{schoolName},
	        #{division},
	        #{startPeriod},
	        #{endPeriod},
	        #{major},
	        #{grade},
	        #{location}
	    )
	</insert>
    
    <!-- 학력을 삭제하기 위한 쿼리문 -->
	<delete id="deleteEducation" parameterType="String">
	   DELETE FROM EDUCATION WHERE SEQ = #{seq}
	</delete>
	
	<!-- 학력을 가져오기 위한 쿼리문 -->	
	<select id="getEducationList" parameterType="String" resultMap="educationVo">
	    SELECT * FROM EDUCATION WHERE SEQ = #{seq}
	</select>
	
	<update id="updateEducationList" parameterType="com.spring.education.vo.EducationVo">
	    UPDATE EDUCATION 
	    SET SCHOOL_NAME = #{schoolName}, 
	        DIVISION = #{division}, 
	        START_PERIOD = #{startPeriod},
	        END_PERIOD = #{endPeriod},
	        MAJOR = #{major},
	        GRADE = #{grade},
	        LOCATION = #{location}
	    WHERE EDU_SEQ = #{eduSeq}
	</update>
	
	<delete id="deleteEducationByEduSeq" parameterType="com.spring.education.vo.EducationVo">
	    DELETE FROM EDUCATION WHERE EDU_SEQ = #{eduSeq}
	</delete>
</mapper>
